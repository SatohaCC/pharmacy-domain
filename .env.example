# Frontend（frontend/.env.local へコピーして利用。Next.js 開発時のプロキシ先）
BACKEND_URL=http://127.0.0.1:8000

# Backend（pydantic-settings がプロセス環境変数から読み込む）
# 許可する Origin をカンマ区切りで指定
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 本番環境で /docs, /redoc, /openapi.json を非公開にする場合は false を指定
DOCS_ENABLED=true
# アプリケーションログレベル（DEBUG / INFO / WARNING / ERROR / CRITICAL）
LOG_LEVEL=INFO
# SQLite データベースファイルの保存先（backend/ 基準の相対パス、絶対パス、または :memory:）
DATABASE_PATH=data/app.db
