{
  "git-commit-review": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/lint-review-hook.mts pre-tool",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/lint-review-hook.mts post-tool",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
