{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o ../.cache/storybook-static",
    "test:storybook": "pnpm build-storybook && playwright test --config playwright.storybook.config.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.2",
    "@tanstack/react-query": "^5.108.0",
    "@ui-sdk/core": "0.1.0-beta.10",
    "@ui-sdk/react": "0.1.0-beta.10",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@storybook/nextjs-vite": "^10.6.7",
    "@stylexjs/babel-plugin": "^0.19.2",
    "@stylexjs/postcss-plugin": "^0.19.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
